{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "tf:init": {
      "cache": false
    },
    "tf:plan": {
      "cache": false
    },
    "tf:apply": {
      "cache": false
    }
  }
}
