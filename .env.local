# LocalStack endpoints
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Serverless LocalStack config
LOCALSTACK_HOST=http://localhost
LOCALSTACK_ENDPOINT_FILE=./localstack-endpoints.json

# MailHog (catches SES emails)
SMTP_HOST=localhost
SMTP_PORT=1025
SES_FROM_ADDRESS=noreply@local.dev

# API
API_BASE_URL=http://localhost:4566

# Cognito (from bootstrap)
COGNITO_USER_POOL_ID=order-platform-local-user-pool
COGNITO_CLIENT_ID=local-client-id
